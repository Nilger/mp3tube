# Shared secret the frontend must send in the "x-api-key" header (for /convert and DELETE /files/:id).
# Generate something random, e.g.: openssl rand -hex 32
API_SECRET=change-me

# Comma-separated list of origins allowed to call this API (your Lovable site's URL).
# Use "*" only while testing locally.
ALLOWED_ORIGIN=https://your-mp3flow-site.example.com

# Where converted mp3s are stored persistently. Must be a Railway Volume mount
# (or any persistent disk) so files survive redeploys.
DATA_DIR=/data/files

# Files older than this are deleted automatically by an hourly cleanup job.
RETENTION_DAYS=7

# Optional caps
MAX_DURATION_SECONDS=10800
PORT=8080
