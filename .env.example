# Server-only — the password to access the site's login screen.
SITE_PASSWORD=change-me

# Exposed to the browser (VITE_ prefix). Point this at your deployed
# mp3flow-backend service (see the backend README for Railway deploy steps).
VITE_BACKEND_URL=https://your-backend.up.railway.app
# Must match API_SECRET set on the backend. This IS visible in the browser
# bundle — that's an accepted trade-off since the site itself is already
# behind SITE_PASSWORD login.
VITE_BACKEND_API_KEY=same-value-as-backend-API_SECRET
